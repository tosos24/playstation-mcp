# Your PlayStation NPSSO token (64 characters).
# Get it: log in at playstation.com, then open
# https://ca.account.sony.com/api/v1/ssocookie and copy the "npsso" value.
NPSSO=

# Only needed for web mode (MODE=http). At least 32 random characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
MODE=stdio
MCP_SECRET=
